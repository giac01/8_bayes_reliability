#!/bin/bash -l
#!
#! SLURM ARRAY job script for King's College London CREATE HPC cluster
#! Docs: https://docs.er.kcl.ac.uk/CREATE/running_jobs/
#!
#! Each array task runs 2_study1_1_simulate.R with RUN_REP=1 (one full pass
#! over the loading_set x sample_sizes grid = 21 sims/task) and its own seed.
#! 100 tasks x 1 rep matches the old script's "100 reps" target. Seeds are
#! offset by 10000 so HPC-run results are distinguishable from local fits.
#!

#SBATCH --job-name=study1_array
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=3G
#SBATCH --time=01:20:00
#SBATCH --array=1001-1648
#! Array jobs with BEGIN/END mail-type would send ~100+ emails - FAIL only:
#SBATCH --mail-type=FAIL
#SBATCH --mail-user=k2583181@kcl.ac.uk
#SBATCH --output=/scratch/users/%u/%A_%a.out

#! ---------------------------------------------------------------------------
#! Singularity is pre-installed on CREATE compute nodes - no module load
#! needed (unlike Rosalind, which requires `module load apps/singularity/...`).
#! It is NOT available on the login nodes, so this must run as a batch job
#! or from within an interactive compute-node session.
#! Docs: https://docs.er.kcl.ac.uk/CREATE/software/singularity/
#!
#! IMPORTANT: cmdstanr caches the compiled Stan binary and skips recompiling
#! if the .stan file is unchanged - but if no cached binary exists yet and
#! many array tasks start at once, they can race to compile it simultaneously
#! and corrupt each other's output. Compile once interactively before first
#! use of this script (or after editing stan_models/stan_inequiv_factor_model_v16.stan):
#!
#!   srun -p cpu --time 20 --pty /bin/bash -l
#!   singularity exec tidyverse461.sif Rscript -e 'source("1_setup.R"); cmdstanr::set_cmdstan_path(path = "/users/k2583181/.cmdstan/cmdstan-2.39.0"); cmdstan_model(file.path("stan_models","stan_inequiv_factor_model_v16.stan"))'
#!   exit
#! ---------------------------------------------------------------------------

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

export RUN_REP="1"
export SEED_ENV=$((10000 + SLURM_ARRAY_TASK_ID))

#! Path to the singularity image (lives alongside this script in the repo):
SIF="$SLURM_SUBMIT_DIR/tidyverse461.sif"

#! sbatch's default working directory is the one it was submitted from:
workdir="$SLURM_SUBMIT_DIR"
cd "$workdir" || exit 1

echo -e "JobID: $SLURM_JOB_ID (array task $SLURM_ARRAY_TASK_ID of $SLURM_ARRAY_TASK_COUNT)\n======"
echo "Time: $(date)"
echo "Running on node: $(hostname)"
echo "Working directory: $(pwd)"
echo "SEED_ENV: $SEED_ENV"

echo -e "\nExecuting command:\n==================\nsingularity exec $SIF Rscript 2_study1_1_simulate.R\n"

singularity exec "$SIF" Rscript 2_study1_1_simulate.R
