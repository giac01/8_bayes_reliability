#!/bin/bash -l
#!
#! SLURM ARRAY job script for King's College London CREATE HPC cluster
#! Docs: https://docs.er.kcl.ac.uk/CREATE/running_jobs/
#!
#! Each array task runs 3_study2_1_simulate.R with RUN_REP=1 (one full pass
#! over the sens_sigma x sample_sizes x n_items grid = 27 sims/task) and its
#! own seed. 100 tasks x 1 rep matches the old script's "100 reps" target.
#! Seeds are offset by 10000 so HPC-run results are distinguishable from
#! local fits.
#!

#SBATCH --job-name=study2_array
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=01:30:00
#SBATCH --array=1-1000
#! Array jobs with BEGIN/END mail-type would send ~100+ emails - FAIL only:
#SBATCH --mail-type=FAIL
#SBATCH --mail-user=k2583181@kcl.ac.uk
#SBATCH --output=/scratch/users/%u/%A_%a.out

#! ---------------------------------------------------------------------------
#! Singularity is pre-installed on CREATE compute nodes - no module load
#! needed (unlike Rosalind, which requires `module load apps/singularity/...`).
#! It is NOT available on the login nodes, so this must run as a batch job
#! or from within an interactive compute-node session.
#! Docs: https://docs.er.kcl.ac.uk/CREATE/software/singularity/
#!
#! NOTE: this script's model is compiled by brms::brm() at runtime (not a
#! pre-existing .stan file via cmdstan_model()), so there's no equivalent
#! cache-warming step to run first - each task compiles independently.
#! ---------------------------------------------------------------------------

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

export RUN_REP="1"
export SEED_ENV=$((10000 + SLURM_ARRAY_TASK_ID))

#! Path to the singularity image (lives alongside this script in the repo):
SIF="$SLURM_SUBMIT_DIR/tidyverse461.sif"

#! sbatch's default working directory is the one it was submitted from:
workdir="$SLURM_SUBMIT_DIR"
cd "$workdir" || exit 1

echo -e "JobID: $SLURM_JOB_ID (array task $SLURM_ARRAY_TASK_ID of $SLURM_ARRAY_TASK_COUNT)\n======"
echo "Time: $(date)"
echo "Running on node: $(hostname)"
echo "Working directory: $(pwd)"
echo "SEED_ENV: $SEED_ENV"

echo -e "\nExecuting command:\n==================\nsingularity exec $SIF Rscript 3_study2_1_simulate.R\n"

singularity exec "$SIF" Rscript 3_study2_1_simulate.R
