#!/bin/bash -l
#!
#! SLURM ARRAY job script for King's College London CREATE HPC cluster
#! Docs: https://docs.er.kcl.ac.uk/CREATE/running_jobs/
#!
#! Splits the RUN_REP=100 simulation into 100 single-core array tasks (1 rep
#! each) instead of one job asking for many cores on the same node at once.
#! Single-core tasks schedule into small idle gaps far more easily - see
#! `sinfo -p cpu -N -o "%N %C %t"` for how packed the cluster typically is.
#!
#! Target is 250 total reps (seeds 1001-1250, i.e. task ids 1-250). The
#! --array list below is not 1-250: it's exactly the task ids with no
#! results/study3_results/study3_results_seed_*.rds file yet, as of the
#! snapshot taken 2026-08-12 (some ids in 1-100 never produced output, and
#! 101-250 were never submitted). Re-derive it from a fresh `ls` before
#! resubmitting again, since some of these ids may complete in the meantime.
#!

#SBATCH --job-name=study3_array
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=12:00:00
#SBATCH --array=1-2,6-10,13-15,21-22,59-74,76-250
#! Array jobs with BEGIN/END mail-type would send ~100+ emails - FAIL only:
#SBATCH --mail-type=FAIL
#SBATCH --mail-user=k2583181@kcl.ac.uk
#SBATCH --output=/scratch/users/%u/%A_%a.out

#! ---------------------------------------------------------------------------
#! Each array task runs 4_study3_1_simulate.R with RUN_REP=1 (one rep of all
#! 18 param combinations = 18 sims/task) and a task-specific seed. The array
#! below covers only the missing task ids so the total across all submissions
#! reaches 250 reps. Each task writes its own results/study3_results/*.rds file (existing
#! seed+timestamp filename already prevents collisions), and
#! 4_study3_2_analysis.R already reads/combines every matching file in that
#! folder - no merge step needed.
#!
#! IMPORTANT - compile the Stan model once before first use of this script:
#! cmdstanr caches the compiled binary and skips recompiling when the .stan
#! file is unchanged, but if no cached binary exists yet and many array tasks
#! start at once, they can race to compile it simultaneously and corrupt each
#! other's output. Warm the cache once interactively first (or whenever
#! stan_models/stan_two_arm_bandit_v6.stan changes):
#!
#!   srun -p cpu --time 20 --pty /bin/bash -l
#!   singularity exec tidyverse461.sif Rscript -e 'source("1_setup.R"); cmdstanr::set_cmdstan_path(path = "/users/k2583181/.cmdstan/cmdstan-2.39.0"); cmdstan_model(file.path("stan_models","stan_two_arm_bandit_v6.stan"))'
#!   exit
#!
#! Then submit this array job as normal: sbatch 4_study3_0_slurm_array
#! ---------------------------------------------------------------------------

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

export RUN_REP="1"
export SEED_ENV=$((1000 + SLURM_ARRAY_TASK_ID))

#! Path to the singularity image (lives alongside this script in the repo):
SIF="$SLURM_SUBMIT_DIR/tidyverse461.sif"

#! sbatch's default working directory is the one it was submitted from:
workdir="$SLURM_SUBMIT_DIR"
cd "$workdir" || exit 1

echo -e "JobID: $SLURM_JOB_ID (array task $SLURM_ARRAY_TASK_ID of $SLURM_ARRAY_TASK_COUNT)\n======"
echo "Time: $(date)"
echo "Running on node: $(hostname)"
echo "Working directory: $(pwd)"
echo "SEED_ENV: $SEED_ENV"

echo -e "\nExecuting command:\n==================\nsingularity exec $SIF Rscript 4_study3_1_simulate.R\n"

singularity exec "$SIF" Rscript 4_study3_1_simulate.R
