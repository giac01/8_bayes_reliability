#!/bin/bash -l
#!
#! SLURM job script for King's College London CREATE HPC cluster
#! Docs: https://docs.er.kcl.ac.uk/CREATE/running_jobs/
#!

#SBATCH --job-name=study3_rep100_seed101
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#! future::multicore() below forks up to this many worker processes - match
#! it to the actual core count of a 'cpu' partition node (see the CREATE
#! "Compute Nodes" docs, or run `sinfo -p cpu -o "%c"`) and adjust as needed:
#SBATCH --cpus-per-task=32
#SBATCH --time=12:00:00
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=k2583181@kcl.ac.uk
#! Recommended: direct output to fast scratch storage
#SBATCH --output=/scratch/users/%u/%j.out

#! ---------------------------------------------------------------------------
#! Runs 4_study3_1_simulate.R inside the bignardig/tidyverse461 singularity
#! container.
#! ---------------------------------------------------------------------------

#! Singularity is pre-installed on CREATE compute nodes - no module load
#! needed (unlike Rosalind, which requires `module load apps/singularity/...`).
#! It is NOT available on the login nodes, so this must run as a batch job
#! or from within an interactive compute-node session.
#! Docs: https://docs.er.kcl.ac.uk/CREATE/software/singularity/

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

export RUN_REP="100"
export SEED_ENV="101"

#! Path to the singularity image (lives alongside this script in the repo):
SIF="$SLURM_SUBMIT_DIR/tidyverse461.sif"

#! sbatch's default working directory is the one it was submitted from:
workdir="$SLURM_SUBMIT_DIR"
cd "$workdir" || exit 1

echo -e "JobID: $SLURM_JOB_ID\n======"
echo "Time: $(date)"
echo "Running on node: $(hostname)"
echo "Working directory: $(pwd)"
echo "CPUs allocated: $SLURM_CPUS_PER_TASK"

echo -e "\nExecuting command:\n==================\nsingularity exec $SIF Rscript 4_study3_1_simulate.R\n"

singularity exec "$SIF" Rscript 4_study3_1_simulate.R
